<Window x:Class="BitCrackGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BitCrack Control Center — CUDA GPU Edition" 
        Height="780" Width="1200"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117" Foreground="#E2E8F0"
        FontFamily="Segoe UI, Inter, Roboto">

    <Window.Resources>
        <!-- Modern Dark Theme Styles -->
        <SolidColorBrush x:Key="CardBackground" Color="#1A1D27"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A2F3D"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#232736" Padding="12,8" CornerRadius="8,8,0,0">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D0F14"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0D0F14"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & GPU Cards -->
            <RowDefinition Height="*"/>    <!-- Main Dashboard -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER BANNER & GPU INFO -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Stats -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="⚡ BitCrack Control Center" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CUDA READY" FontSize="11" FontWeight="Bold" Foreground="#042F2E"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Secp256k1 GPU High-Speed Key Search Engine" FontSize="13" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>

            <!-- GPU Hardware Card -->
            <Border Grid.Column="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🎮" FontSize="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TxtGpuName" Text="Detecting GPU..." FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Memory: " FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="TxtGpuMemory" Text="Auto Memory" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,12,0"/>
                            <TextBlock Text="Cores: " FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="TxtGpuCores" Text="Auto CUDA" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Arch: " FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="TxtGpuArch" Text="NVIDIA CUDA Architecture" FontSize="12" FontWeight="SemiBold" Foreground="#3B82F6"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- MAIN DASHBOARD CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/> <!-- Left Config Panel -->
                <ColumnDefinition Width="*"/>   <!-- Right Live Monitor & Console -->
            </Grid.ColumnDefinitions>

            <!-- LEFT CONFIG PANEL -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <!-- TARGET ADDRESS CONFIG -->
                    <GroupBox Header="🎯 Target Addresses &amp; Public Key">
                        <StackPanel>
                            <!-- Mode 1: Single Address -->
                            <RadioButton x:Name="RbSingleTarget" Content="Single Address / Public Key Mode" IsChecked="True" Checked="RbTargetMode_Changed" Unchecked="RbTargetMode_Changed" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtTargetAddress" Text="1EeAxcprB2PpCnr34VfZdFrkUWuxyiNEFv" ToolTip="Bitcoin adresi (1...) veya doğrudan Public Key (02/03/04...) girebilirsiniz."/>
                                <Button x:Name="BtnCheckApi" Grid.Column="1" Content="🔍 Check API" Click="BtnCheckApi_Click" Margin="6,0,0,0" Padding="10,4" Background="#8B5CF6"/>
                            </Grid>

                            <!-- Target Public Key Field -->
                            <TextBlock Text="Target Public Key (Hex - Kanguru Modu):" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,2"/>
                            <TextBox x:Name="TxtPublicKeyHex" Text="" TextChanged="TxtPublicKeyHex_TextChanged" Margin="0,0,0,6" ToolTip="API kontrolü ile otomatik dolar veya elle Public Key (02/03/04...) yapıştırabilirsiniz."/>

                            <TextBlock x:Name="TxtApiStatus" Text="" FontSize="11" TextWrapping="Wrap" Foreground="#38BDF8" Margin="0,0,0,10"/>

                            <!-- Mode 2: Bulk File List -->
                            <RadioButton x:Name="RbFileTarget" Content="Bulk File List Mode (.txt)" Checked="RbTargetMode_Changed" Unchecked="RbTargetMode_Changed" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtTargetsFile" Text="" IsEnabled="False"/>
                                <Button x:Name="BtnBrowseTargets" Grid.Column="1" Content="Browse..." Click="BtnBrowseTargets_Click" Margin="6,0,0,0" Padding="12,4" IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ALGORITHM MODE CONFIG -->
                    <GroupBox Header="🧠 Search Engine Algorithm Mode">
                        <StackPanel>
                            <RadioButton x:Name="RbAlgoBitCrack" Content="Standard BitCrack Engine (Linear Multi-Hash O(N))" IsChecked="True" Checked="RbAlgo_Changed" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <RadioButton x:Name="RbAlgoKangaroo" Content="cuBitCrack Kangaroo Engine (Native CUDA O(√N))" Checked="RbAlgo_Changed" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <RadioButton x:Name="RbAlgoRCKangaroo" Content="⚡ RCKangaroo v3.1 Engine (SOTA+ ~8 GKey/s)" Checked="RbAlgo_Changed" Foreground="#10B981" FontWeight="Bold"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- GPU TUNING PARAMETERS -->
                    <GroupBox x:Name="GbGpuParams" Header="⚡ GPU Performance Parameters">
                        <StackPanel>
                            <!-- Compression Mode -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Compression Mode:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton x:Name="RbCompressed" Content="Compressed (-c)" IsChecked="True" Foreground="#E2E8F0" Margin="0,0,8,0"/>
                                    <RadioButton x:Name="RbUncompressed" Content="Uncompressed (-u)" Foreground="#E2E8F0" Margin="0,0,8,0"/>
                                    <RadioButton x:Name="RbBoth" Content="Both" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Blocks (-b) -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="GPU Blocks (-b):" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtBlocksVal" Text="1024" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                            </Grid>
                            <Slider x:Name="SliderBlocks" Minimum="64" Maximum="4096" Value="1024" TickFrequency="64" IsSnapToTickEnabled="True" ValueChanged="SliderBlocks_ValueChanged" Margin="0,0,0,10"/>

                            <!-- Threads (-t) -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Threads per Block (-t):" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtThreadsVal" Text="256" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                            </Grid>
                            <Slider x:Name="SliderThreads" Minimum="64" Maximum="512" Value="256" TickFrequency="32" IsSnapToTickEnabled="True" ValueChanged="SliderThreads_ValueChanged" Margin="0,0,0,10"/>

                            <!-- Kangaroo Count Info -->
                            <Border Background="#1E293B" CornerRadius="6" Padding="8,6" Margin="0,2,0,10" BorderBrush="#334155" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="🦘 Total Kangaroo Pairs:" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtKangarooCountVal" Text="262,144 Pairs (524,288 Kangaroos)" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#38BDF8" FontSize="11"/>
                                </Grid>
                            </Border>

                            <!-- Points per Thread (-p) -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Points per Thread (-p):" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtPointsVal" Text="32" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                            </Grid>
                            <Slider x:Name="SliderPoints" Minimum="4" Maximum="128" Value="32" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="SliderPoints_ValueChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- KEYSPACE RANGE & PUZZLE PRESETS -->
                    <GroupBox Header="🔑 Keyspace Range (Hex) &amp; Presets">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Start Key (Hex):" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtKeyStart" Text="1" TextChanged="TxtKeyRange_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="End Key (Hex):" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtKeyEnd" Text="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364140" TextChanged="TxtKeyRange_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,4,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Select Puzzle (#1 - #256):" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CboPuzzleSelect" Grid.Column="1" SelectionChanged="CboPuzzleSelect_SelectionChanged"/>
                            </Grid>

                            <TextBlock Text="Quick Range Presets:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,4"/>
                            <UniformGrid Columns="5" Margin="0,0,0,4">
                                <Button Content="Puzzle #20" Click="BtnPresetPuzzle20_Click" Margin="2" Padding="4,4" FontSize="11" Background="#2D3748"/>
                                <Button Content="Puzzle #40" Click="BtnPresetPuzzle40_Click" Margin="2" Padding="4,4" FontSize="11" Background="#2D3748"/>
                                <Button Content="Puzzle #66" Click="BtnPresetPuzzle66_Click" Margin="2" Padding="4,4" FontSize="11" Background="#2D3748"/>
                                <Button Content="Puzzle #80" Click="BtnPresetPuzzle80_Click" Margin="2" Padding="4,4" FontSize="11" Background="#2D3748"/>
                                <Button Content="Puzzle #100" Click="BtnPresetPuzzle100_Click" Margin="2" Padding="4,4" FontSize="11" Background="#2D3748"/>
                                <Button Content="Puzzle #120" Click="BtnPresetPuzzle120_Click" Margin="2" Padding="4,4" FontSize="11" Background="#2D3748"/>
                                <Button Content="Puzzle #140" Click="BtnPresetPuzzle140_Click" Margin="2" Padding="4,4" FontSize="11" Background="#2D3748"/>
                                <Button Content="Puzzle #160" Click="BtnPresetPuzzle160_Click" Margin="2" Padding="4,4" FontSize="11" Background="#2D3748"/>
                                <Button Content="Puzzle #256" Click="BtnPresetPuzzle256_Click" Margin="2" Padding="4,4" FontSize="11" Background="#2D3748"/>
                            </UniformGrid>

                            <!-- DP Bits (-dp) -->
                            <Grid Margin="0,8,0,4">
                                <TextBlock Text="Distinguished Points Bits (-dp):" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtDpBitsVal" Text="16" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Grid>
                            <Slider x:Name="SliderDpBits" Minimum="6" Maximum="60" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderDpBits_ValueChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- CHECKPOINT & OUTPUT OPTIONS -->
                    <GroupBox Header="💾 Checkpoint &amp; Output Settings">
                        <StackPanel>
                            <CheckBox x:Name="ChkEnableCheckpoint" Content="Enable Checkpoint (--continue)" IsChecked="False" Foreground="#E2E8F0" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCheckpointFile" Text="progress.ci"/>
                                <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseCheckpoint_Click" Margin="6,0,0,0" Padding="12,4"/>
                            </Grid>

                            <TextBlock Text="Output Results File (-o):" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtResultsFile" Text="found_keys.txt"/>
                                <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseResults_Click" Margin="6,0,0,0" Padding="12,4"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- KANGAROO GUIDE / TAMES FILE CONFIG -->
                    <GroupBox Header="🦘 Kangaroo Guide / Tames File (-tames)">
                        <StackPanel>
                            <CheckBox x:Name="ChkUseTames" Content="Use Pre-calculated Guide File (.tames)" IsChecked="False" Checked="ChkUseTames_Changed" Unchecked="ChkUseTames_Changed" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtTamesFile" Text="" IsEnabled="False"/>
                                <Button x:Name="BtnBrowseTames" Grid.Column="1" Content="Browse..." Click="BtnBrowseTames_Click" Margin="6,0,0,0" Padding="12,4" IsEnabled="False"/>
                            </Grid>

                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tames Gen Max K Factor (-max):" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtTamesMax" Grid.Column="1" Text="4.0" Width="80" IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT LIVE MONITOR & CONSOLE PANEL -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Live Gauge Cards -->
                    <RowDefinition Height="Auto"/> <!-- Found Key Banner -->
                    <RowDefinition Height="*"/>    <!-- Live Console Output -->
                    <RowDefinition Height="Auto"/> <!-- Start/Stop Controls -->
                </Grid.RowDefinitions>

                <!-- LIVE GAUGE CARDS -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Speed Card -->
                    <Border Grid.Column="0" Background="#1A2234" BorderBrush="#2B3854" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="SCAN SPEED" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                            <TextBlock x:Name="TxtLiveSpeed" Text="0.00 MKey/s" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Keys Card -->
                    <Border Grid.Column="1" Background="#1A2721" BorderBrush="#254232" BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL KEYS CHECKED" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock x:Name="TxtTotalKeys" Text="0" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Elapsed Time Card -->
                    <Border Grid.Column="2" Background="#261C2C" BorderBrush="#42294E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ELAPSED TIME" FontSize="11" FontWeight="Bold" Foreground="#C084FC"/>
                            <TextBlock x:Name="TxtElapsedTime" Text="00:00:00" FontSize="22" FontWeight="Bold" Foreground="#A855F7" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FOUND KEY BANNER (Collapsible) -->
                <Border x:Name="BorderKeyFound" Grid.Row="1" Background="#064E3B" BorderBrush="#10B981" BorderThickness="2" CornerRadius="8" Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎉 PRIVATE KEY FOUND!" FontSize="18" FontWeight="Bold" Foreground="#34D399"/>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Address:" FontWeight="Bold" Foreground="#A7F3D0"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFoundAddress" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#F0FDF4" FontWeight="Bold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Private Key:" FontWeight="Bold" Foreground="#A7F3D0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtFoundPrivateKey" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#FACC15" FontWeight="Bold" FontSize="14"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Public Key:" FontWeight="Bold" Foreground="#A7F3D0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtFoundPublicKey" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#93C5FD"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- LIVE CONSOLE TERMINAL -->
                <GroupBox Grid.Row="2" Header="📟 Live Execution Output &amp; GPU Logs">
                    <Grid>
                        <TextBox x:Name="TxtConsoleLog" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" 
                                 FontFamily="Consolas, Cascadia Code, Courier New" 
                                 FontSize="12" 
                                 Background="#090B0E" 
                                 Foreground="#38BDF8"/>
                    </Grid>
                </GroupBox>

                <!-- START / STOP TOGGLE CONTROL -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Button x:Name="BtnStart" Content="🚀 START SCANNING (RTX 2060 SUPER)" Click="BtnStart_Click" Height="48" FontSize="15" FontWeight="Bold" Background="#10B981" Foreground="White" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="2" Background="#090B0E" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Margin="-16,12,-16,-16" Padding="12,6">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Ready." Foreground="{StaticResource TextMuted}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
